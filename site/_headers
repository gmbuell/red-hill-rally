# Served by the Workers static-assets layer. Pages get their preload
# hint and cache life from worker/pages.js.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fonts are content-stable; let repeat visits skip the network entirely.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
