{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "red-hill-rally",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domains on the rocketrally.org zone; the worker sends www to
  // the apex. With routes set, wrangler leaves workers.dev off for this
  // worker.
  "routes": [
    { "pattern": "rocketrally.org", "custom_domain": true },
    { "pattern": "www.rocketrally.org", "custom_domain": true }
  ],

  // The pages and files under ./site, served as-is — no build step.
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every navigation runs the worker (pages are rendered there, and
    // so are short links, API-in-browser, and partner logos from R2);
    // files under these paths are served straight from the asset layer.
    "run_worker_first": ["/*", "!/css/*", "!/fonts/*", "!/js/*", "!/img/*", "!/favicon.svg"]
  },

  "r2_buckets": [
    // Partner logo uploads from the thank-you page (POST /api/partner/logo).
    { "binding": "LOGOS", "bucket_name": "red-hill-rally-logos" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "red-hill-rally",
      "database_id": "2b01227d-9ceb-499f-aff1-0ccd87902e11",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Secrets (wrangler secret put): ADMIN_KEY, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET

  // PR previews: a second worker with its own database (seeded with
  // the demo donations) and logo bucket, reachable only on workers.dev.
  // It holds no Stripe secrets, so checkout answers 503 there as it
  // does in local dev. Workers Builds uploads every non-main branch to
  // it with `npm run preview`; the PR's Workers Builds check links the
  // preview URL.
  "env": {
    "preview": {
      "name": "red-hill-rally-preview",
      "routes": [],
      "workers_dev": true,
      "preview_urls": true,
      "r2_buckets": [
        { "binding": "LOGOS", "bucket_name": "red-hill-rally-preview-logos" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "red-hill-rally-preview",
          "database_id": "50a231ac-c415-44b0-b4c9-5288097b344f",
          "migrations_dir": "./migrations"
        }
      ]
    }
  }
}
